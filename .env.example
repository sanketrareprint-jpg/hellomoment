# Copy this file to .env and fill in real values before running the app.

# SQLite by default (fine for a small/medium deployment). Swap to a Postgres
# connection string ("postgresql://user:pass@host:5432/db") for production
# scale without changing any code (just also change `provider = "sqlite"` to
# `"postgresql"` in prisma/schema.prisma), then run `npm run db:push`.
#
# Locally this defaults to a file next to the project. In production, point
# it at the same persistent volume as STORAGE_DIR below, e.g. on Railway:
#   DATABASE_URL="file:/app/storage/data/dev.db"
DATABASE_URL="file:./storage/data/dev.db"

# Where uploaded photos, template backgrounds, and generated flyers are
# stored on disk. Defaults to ./storage (gitignored) for local development.
# In production, set this to a path on your persistent volume, e.g. on
# Railway: mount a volume at /app/storage, then set STORAGE_DIR=/app/storage
# (the app creates photos/, templates/, and generated/ subfolders inside it
# automatically — keep DATABASE_URL's dev.db under a DIFFERENT subfolder of
# the same volume, e.g. /app/storage/data/dev.db, never inside a folder this
# app serves publicly).
STORAGE_DIR="./storage"

# Used to sign login session tokens. Generate a random 32+ char string, e.g.:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# The public base URL this app is deployed at, no trailing slash.
# AiSensy fetches generated flyer images from <APP_BASE_URL>/api/files/generated/<id>.jpg,
# so this MUST be a publicly reachable HTTPS URL in production (not localhost).
APP_BASE_URL="https://hellomoment.in"

# Shared secret that protects the daily trigger endpoint
# (POST or GET /api/cron/daily). Your external scheduler (Railway Cron Job /
# a plain cron job / GitHub Actions) must send this as:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-another-long-random-secret"

# Each business enters their own AiSensy API key in Settings inside the app
# (stored in the database), so no global AiSensy key is required here.
# This one is only used as an optional fallback / for local testing.
AISENSY_API_KEY=""

# Password for the admin dashboard at /admin, which lists every business
# that has signed up on hellomoment.in (yours only — not shown to
# businesses). Pick your own password and set this on Railway too, under
# your service's Variables tab. Leave unset to keep /admin disabled.
ADMIN_PASSWORD=""

# Razorpay — powers the Wallet page, where businesses recharge their prepaid
# balance to pay for WhatsApp sends. Get these from your own Razorpay
# dashboard: Settings → API Keys (use your LIVE keys once you're ready to
# accept real payments; Razorpay also gives you separate Test keys while
# you're trying it out). Set both on Railway too, under your service's
# Variables tab — the Wallet page's recharge button will fail with an error
# until both are set.
#   RAZORPAY_KEY_ID    — starts with "rzp_live_" (or "rzp_test_")
#   RAZORPAY_KEY_SECRET — shown once when the key is generated; if you lose
#                          it, generate a new key pair in the Razorpay
#                          dashboard and update both values here.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Resend — sends the "forgot password" reset-link email. Sign up free at
# resend.com (free tier covers up to 3,000 emails/month), then Dashboard →
# API Keys → Create API Key, and paste it below. Set this on Railway too.
#   RESEND_API_KEY starts with "re_"
#
# IMPORTANT: until you verify a domain in Resend (Dashboard → Domains →
# Add Domain, e.g. raregreet.com, then add the DNS records it gives you —
# wherever your domain's DNS is managed), the default sender
# onboarding@resend.dev can ONLY deliver to the email address YOUR Resend
# account itself signed up with. Reset emails to any of your businesses'
# real email addresses will silently fail until you verify a domain. Once
# verified, set EMAIL_FROM below to an address at that domain, e.g.
# "RareGreet <noreply@raregreet.com>".
RESEND_API_KEY=""
EMAIL_FROM=""
